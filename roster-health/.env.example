# Copy to `.env` (git-ignored) and fill in. `run_local.sh` sources this file.
# NOTHING here is committed — .env is in .gitignore.

# --- ESPN private league (activates the live roster pull) ---
# From your browser after logging into espn.com:
#   F12 -> Application/Storage -> Cookies -> https://www.espn.com
ESPN_SWID={PASTE-WITH-BRACES}
ESPN_S2=PASTE_LONG_STRING
# league_id / team_id are already in config.yaml (400979538 / 15); override here if needed:
# ESPN_LEAGUE_ID=400979538
# ESPN_TEAM_ID=15

# --- Notifications ---
# stub  = print only (safe default while testing)
# github= post the digest as a comment on a PR/issue Claude Code is watching
# ntfy  = push to your phone via ntfy.sh
NOTIFY_PROVIDER=stub

# ntfy (if NOTIFY_PROVIDER=ntfy):
# NTFY_TOPIC=your-unique-topic-name
# NTFY_TOKEN=optional-auth-token

# GitHub report-back (if NOTIFY_PROVIDER=github) — reports results back to Claude:
# GITHUB_TOKEN=github_pat_xxx      # fine-grained token, issues:write on herggie/ken
# NOTIFY_GITHUB_REPO=herggie/ken   # optional; defaults to herggie/ken
# NOTIFY_GITHUB_ISSUE=1            # PR/issue number to comment on (PR #1)
